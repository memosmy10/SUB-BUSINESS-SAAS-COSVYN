
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is the specific admin
    function isAdmin() {
      return request.auth.token.email == 'cosvynsolutions@gmail.com';
    }

    // Business Collection Rules
    match /businesses/{userId} {
      allow read, write: if request.auth.uid == userId || isAdmin();

      // Sub-collections (customers, expenses, plans, etc.)
      match /{document=**} {
        allow read, write: if request.auth.uid == userId || isAdmin();
      }
    }

    // Collection Group Query for Admin Dashboard & Payments
    // This allows fetching 'billing_history' from all users at once
    match /{path=**}/billing_history/{docId} {
      allow read: if isAdmin();
    }

    // Collection Group Query for Payments (Legacy/Backup)
    match /{path=**}/payments/{paymentId} {
      allow read: if isAdmin();
    }

    // Global Collections for Support/Features (Public Write, Admin Read/Update)
    match /global_features/{docId} {
      allow read, write: if request.auth != null;
    }
    match /global_tickets/{docId} {
      allow read, write: if request.auth != null;
    }
    match /global_reviews/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
