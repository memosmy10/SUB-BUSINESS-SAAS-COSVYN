       │  ├─ /businesses/{bizId}            [Multi-tenant root]             │
       │  │  ├─ /staff/{staffId}            [Delivery boys]                 │
       │  │  ├─ /customers/{custId}         [Subscribers]                   │
       │  │  ├─ /delivery_logs/{logId}      [Completion logs]               │
       │  │  ├─ /plans/{planId}             [Meal plans]                    │
       │  │  ├─ /manager_pins/{managerId}   [Manager passwords]             │
