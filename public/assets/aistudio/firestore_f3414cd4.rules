rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // SCALEKITCHEN PHASE 2: HARDENED MULTI-TENANT SECURITY RULES
    // =========================================================================
    // Key principles:
    // 1. Browser NEVER directly modifies subscription, payments, or sensitive tenant data
    // 2. Drivers and Managers authenticate via callable, receive custom token with claims
    // 3. All tenant data scoped by businessId; custom claims enforce per-request access
    // 4. Plaintext data (PINs, passwords) never leave Cloud Functions
    // =========================================================================

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    // 1. Super Admin check: email verified + explicit admin claim OR hardcoded list
    function isAdmin() {
      return request.auth != null && 
             request.auth.token != null && (
               ('admin' in request.auth.token && request.auth.token.admin == true) ||
               (
                 'email_verified' in request.auth.token && 
                 request.auth.token.email_verified == true &&
                 'email' in request.auth.token && (
                   request.auth.token.email.lower() == 'cosvynsolutions@gmail.com' || 
                   request.auth.token.email.lower() == 'admin@scalekitchen.in' ||
                   request.auth.token.email.lower() == 'memosmy10@gmail.com'
                 )
               )
             );
    }

    // 2. Business Owner check: uid == businessId
    function isOwner(bizId) {
      return request.auth != null && request.auth.uid == bizId;
    }

    // 3. Delivery Driver check: custom token claim validates role + bizId
    //    Driver can only act within their assigned business
    function isTenantDriver(bizId) {
      return request.auth != null && 
             request.auth.token != null &&
             'role' in request.auth.token && 
             request.auth.token.role == 'driver' &&
             'bizId' in request.auth.token && 
             request.auth.token.bizId == bizId;
    }

    // 4. Branch Manager check: custom token claim validates role + bizId
    //    Manager can only act within their assigned business
    function isTenantManager(bizId) {
      return request.auth != null && 
             request.auth.token != null &&
             'role' in request.auth.token && 
             request.auth.token.role == 'manager' &&
             'bizId' in request.auth.token && 
             request.auth.token.bizId == bizId;
    }

    // =========================================================================
    // PUBLIC / GLOBAL SYSTEM COLLECTIONS
    // =========================================================================

    // Pricing & Global Configuration (READ-ONLY for everyone)
    match /global_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System broadcast messages (logged-in users only)
    match /admin_messages/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Rate limits (server-side Cloud Functions only)
    match /auth_rate_limits/{docId} {
      allow read, write: if false;
    }

    // Driver Auth Lookup: riders can GET their own record, but NO listing
    // Allows independent device login without needing the owner's Firebase session
    // Owner + functions can write; everyone can anonymously read a single record by phone
    match /driver_auth_lookup/{mobileDigits} {
      allow get: if true;  // Anonymous get for independent device login
      allow list: if false; // Block enumeration attacks
      allow create, update: if isAdmin();  // Only server writes via Cloud Functions
      allow delete: if isAdmin();
    }

    // Free Trial Claim Registry (server-side only)
    match /trial_claims/{claimKey} {
      allow read, write: if false;
    }

    // Pending Subscriber Activations (server-side only)
    match /pending_activations/{email} {
      allow read, write: if false;
    }

    // Global Feature Requests (logged-in users only, no driver prefix)
    match /global_features/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
                       request.resource.data.tenantId == request.auth.uid;
      allow update, delete: if isAdmin() || 
                            (request.auth != null && 
                             resource.data.tenantId == request.auth.uid);
    }

    // Global Support Tickets
    match /global_tickets/{docId} {
      allow read: if isAdmin() || 
                     (request.auth != null && resource.data.tenantId == request.auth.uid);
      allow create: if request.auth != null && 
                       request.resource.data.tenantId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Global Reviews (logged-in users)
    match /global_reviews/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
                       request.resource.data.tenantId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // PHASE 3: PAYMENT ORDERS & SECRETS (Cloud Functions Admin SDK ONLY)
    // Browser can NEVER read or write these directly
    // =========================================================================

    match /orders/{orderId} {
      allow read, write: if false; // Admin SDK only
    }

    match /processed_payments/{paymentId} {
      allow read, write: if false; // Admin SDK only
    }

    match /gemini_rate_limits/{uid} {
      allow read, write: if false; // Admin SDK only
    }

    // =========================================================================
    // MULTI-TENANT BUSINESS DATA (Core: /businesses/{userId}/*)
    // =========================================================================

    match /businesses/{userId} {
      // Business root profile: owner can read/write, drivers/managers can read only
      allow get: if isOwner(userId) || 
                    isTenantDriver(userId) || 
                    isTenantManager(userId) || 
                    isAdmin();
      allow list: if isAdmin();
      
      // Owner can create their own business
      allow create: if isOwner(userId) || isAdmin();
      
      // Owner delete
      allow delete: if isOwner(userId) || isAdmin();

      // Owner update with strict anti-tampering rules
      allow update: if isAdmin() || (
        isOwner(userId) && (
          // A. Free Trial: one-time claim only
          (
            request.resource.data.planName == 'Free Trial' &&
            (!('trialClaimed' in resource.data) || resource.data.trialClaimed != true) &&
            (!('trialStartDate' in resource.data) || resource.data.trialStartDate == null) &&
            request.resource.data.trialClaimed == true
          ) ||
          // B. Mark as Expired (server scheduler does this, but owner can too)
          (
            request.resource.data.planStatus == 'Expired' &&
            request.resource.data.planStatus != resource.data.planStatus
          ) ||
          // C. Safe profile updates (no plan or payment fields can be modified)
          (
            !('planExpiryDate' in request.resource.data.keys()) &&
            !('planStatus' in request.resource.data.keys()) &&
            !('planName' in request.resource.data.keys()) &&
            !('lastPaymentId' in request.resource.data.keys()) &&
            !('trialClaimed' in request.resource.data.keys()) &&
            !('purchasedInvoiceCredits' in request.resource.data.keys())
          )
        )
      );

      // --- Staff Subcollection (Delivery Partners) ---
      match /staff/{staffId} {
        // Owner and managers can read; drivers can read for route display
        allow read: if isOwner(userId) || 
                       isTenantManager(userId) || 
                       isTenantDriver(userId) || 
                       isAdmin();
        
        // Owner and managers can create/update; drivers can only update their own location/status
        allow create, delete: if isOwner(userId) || isTenantManager(userId) || isAdmin();
        
        allow update: if isOwner(userId) || isTenantManager(userId) || isAdmin() ||
          (
            isTenantDriver(userId) && 
            'staffId' in request.auth.token && 
            request.auth.token.staffId == staffId &&
            // Drivers can ONLY update location, status, and attendance (never PIN or name)
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'currentLat', 'currentLng', 'lastLocationUpdate',
              'lastAttendanceDate', 'attendanceMarkedAt', 'batteryLevel', 'updatedAt'
            ])
          );
      }

      // --- Customers Subcollection (Subscribers) ---
      match /customers/{customerId} {
        allow read: if isOwner(userId) || 
                       isTenantManager(userId) || 
                       isTenantDriver(userId) || 
                       isAdmin();
        
        allow create, delete: if isOwner(userId) || isTenantManager(userId) || isAdmin();
        
        allow update: if isOwner(userId) || isTenantManager(userId) || isAdmin() ||
          (
            isTenantDriver(userId) &&
            // Drivers can only update box collection tracking, NOT customer details
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'boxCollections', 'uncollectedBoxesCount', 'updatedAt', 'routeOrder',
              'lastDeliveryDate', 'nextDeliveryDate'
            ])
          );
      }

      // --- Delivery Logs Subcollection ---
      match /delivery_logs/{logId} {
        allow read: if isOwner(userId) || 
                       isTenantManager(userId) || 
                       isTenantDriver(userId) || 
                       isAdmin();
        
        // Everyone in the business can write delivery updates
        allow create, update: if isOwner(userId) || 
                                 isTenantManager(userId) || 
                                 isTenantDriver(userId) || 
                                 isAdmin();
        
        allow delete: if isOwner(userId) || isAdmin();
      }

      // --- Driver Manifest (per-driver route for the day) ---
      match /driver_manifest/{staffId} {
        allow read: if isOwner(userId) || 
                       isTenantManager(userId) || 
                       isTenantDriver(userId) || 
                       isAdmin();
        
        allow write: if isOwner(userId) || isTenantManager(userId) || isAdmin();
      }

      // --- Driver Status (real-time: online/offline, GPS, battery) ---
      match /driver_status/{staffId} {
        allow read: if isOwner(userId) || 
                       isTenantManager(userId) || 
                       isTenantDriver(userId) || 
                       isAdmin();
        
        // Driver updates their own status; owner/manager can reset
        allow write: if isOwner(userId) || isTenantManager(userId) || isAdmin() ||
          (
            isTenantDriver(userId) && 
            'staffId' in request.auth.token && 
            request.auth.token.staffId == staffId
          );
      }

      // --- Driver Sessions (shift start/end logs) ---
      match /driver_sessions/{sessionId} {
        allow read: if isOwner(userId) || 
                       isTenantManager(userId) || 
                       isTenantDriver(userId) || 
                       isAdmin();
        
        allow write: if isOwner(userId) || isTenantManager(userId) || isAdmin() ||
          (
            isTenantDriver(userId)
          );
      }

      // --- Branch Managers ---
      match /managers/{managerId} {
        allow read: if isOwner(userId) || isTenantManager(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // --- Manager Audit Logs ---
      match /manager_logs/{logId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // --- Meal Plans ---
      match /plans/{planId} {
        allow read: if isOwner(userId) || 
                       isTenantManager(userId) || 
                       isTenantDriver(userId) || 
                       isAdmin();
        allow write: if isOwner(userId) || isTenantManager(userId) || isAdmin();
      }

      // --- Kitchen Branches ---
      match /branches/{branchId} {
        allow read: if isOwner(userId) || 
                       isTenantManager(userId) || 
                       isTenantDriver(userId) || 
                       isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // --- Reusable Box Types ---
      match /box_types/{boxId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // --- Financial & Operational (owner/admin only) ---
      match /invoices/{invoiceId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /payments/{paymentId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /billing_history/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // Server only
      }
      match /expenses/{expenseId} {
        allow read, write: if isOwner(userId) || isTenantManager(userId) || isAdmin();
      }
      match /inventory/{itemId} {
        allow read, write: if isOwner(userId) || isTenantManager(userId) || isAdmin();
      }
      match /notes/{noteId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /single_orders/{orderId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Catch-all for other subcollections (deny by default)
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // =========================================================================
    // COLLECTION GROUPS (Analytics & lookup by role)
    // =========================================================================
    
    // Billing history: admins see all, owners see their own
    match /{path=**}/billing_history/{docId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == path[1]);
    }

    // Payment records: admins see all, owners see their own
    match /{path=**}/payments/{docId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == path[1]);
    }

    // Staff lookup by mobile (no direct reads except via driverLogin callable)
    match /{path=**}/staff/{staffId} {
      allow read: if false; // Server only
    }

  }
}
