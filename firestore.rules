rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // SCALEKITCHEN PHASE 2: MULTI-TENANT ISOLATED SECURITY RULES
    // =========================================================================

    // 1. HELPER: Super Admin check with email verification OR custom admin claim
    function isAdmin() {
      return request.auth != null && 
             request.auth.token != null && (
               ('admin' in request.auth.token && request.auth.token.admin == true) ||
               (
                 'email_verified' in request.auth.token && request.auth.token.email_verified == true &&
                 'email' in request.auth.token && (
                   request.auth.token.email.lower() == 'cosvynsolutions@gmail.com' || 
                   request.auth.token.email.lower() == 'admin@scalekitchen.in' ||
                   request.auth.token.email.lower() == 'memosmy10@gmail.com'
                 )
               )
             );
    }

    // 2. HELPER: Business Owner verification (Tenant Root isolation)
    function isOwner(bizId) {
      return request.auth != null && request.auth.uid == bizId;
    }

    // 3. HELPER: Driver verification via custom token claim
    function isTenantDriver(bizId) {
      return request.auth != null && 
             request.auth.token != null &&
             'role' in request.auth.token && request.auth.token.role == 'driver' &&
             'bizId' in request.auth.token && request.auth.token.bizId == bizId;
    }

    // 4. HELPER: Manager verification via custom token claim
    function isTenantManager(bizId) {
      return request.auth != null && 
             request.auth.token != null &&
             'role' in request.auth.token && request.auth.token.role == 'manager' &&
             'bizId' in request.auth.token && request.auth.token.bizId == bizId;
    }

    // =========================================================================
    // GLOBAL SYSTEM COLLECTIONS
    // =========================================================================

    // PUBLIC PRICING & CONFIGURATION (The ONLY public read in the entire SaaS)
    match /global_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // BROADCAST MESSAGES FOR ACTIVE SYSTEM USERS
    match /admin_messages/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // AUTH RATE LIMITS (Server-side Cloud Functions only)
    match /auth_rate_limits/{docId} {
      allow read, write: if false;
    }

    // DRIVER AUTH LOOKUP DIRECTORY (Server-side Cloud Functions only)
    match /driver_auth_lookup/{mobileDigits} {
      allow read, write: if false;
    }

    // FREE TRIAL CLAIM REGISTRY (Server-side Cloud Functions only)
    match /trial_claims/{claimKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // PENDING SUBSCRIBER ACTIVATIONS
    match /pending_activations/{email} {
      allow read, write: if isAdmin();
    }

    // GLOBAL FEATURE REQUESTS (Restricted to legitimate user tickets; driver_* prefixes blocked)
    match /global_features/{docId} {
      allow read: if request.auth != null && !docId.matches('^driver_.*');
      allow create: if request.auth != null && 
                       !docId.matches('^driver_.*') && 
                       request.resource.data.tenantId == request.auth.uid;
      allow update, delete: if isAdmin() || (
        request.auth != null && 
        resource.data.tenantId == request.auth.uid && 
        !docId.matches('^driver_.*')
      );
    }

    // GLOBAL TICKETS & SUPPORT
    match /global_tickets/{docId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.tenantId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.tenantId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // GLOBAL REVIEWS
    match /global_reviews/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.tenantId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // PHASE 3: PAYMENT ORDERS & SECRETS (Cloud Functions Admin SDK ONLY)
    // =========================================================================

    // Orders collection: read-only for order owner or admin, writeable only by Admin/Cloud Functions
    match /orders/{orderId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.bizId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Processed payments: idempotency lock for webhooks and callables (Functions Admin SDK ONLY)
    match /processed_payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    // Gemini rate limits: internal to Cloud Functions
    match /gemini_rate_limits/{uid} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // MULTI-TENANT BUSINESS DATA (Tenant Path: /businesses/{userId}/**)
    // =========================================================================

    match /businesses/{userId} {
      // 1. Root Business Document
      allow get: if isOwner(userId) || isTenantManager(userId) || isTenantDriver(userId) || isAdmin();
      allow list: if isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      // Creation: Owner or Admin. Client is forbidden from self-assigning planStatus, planName, or trial/payment IDs.
      allow create: if isAdmin() || (
        isOwner(userId) &&
        (!('planStatus' in request.resource.data) || request.resource.data.planStatus == 'Inactive') &&
        (!('planName' in request.resource.data) || request.resource.data.planName == 'None') &&
        !request.resource.data.keys().hasAny(['lastPaymentId', 'trialClaimed', 'trialStartDate'])
      );

      // Update: Owner or Admin ONLY.
      // STRICT ANTI-TAMPER: Client CANNOT modify planName, planStatus, planExpiryDate, lastPaymentId, trialClaimed, trialStartDate.
      // These fields can ONLY be written by Cloud Functions using the Firebase Admin SDK.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'planName', 'planStatus', 'planExpiryDate', 'lastPaymentId', 'trialClaimed', 'trialStartDate'
        ])
      );

      // 2. Staff (Delivery Personnel)
      match /staff/{staffId} {
        // Read: Owner, Admin, or Manager. Drivers CANNOT read pinHash or other drivers' credentials.
        allow get, list: if isOwner(userId) || isAdmin() ||
          (
            isTenantManager(userId) &&
            (!('branchId' in request.auth.token) || request.auth.token.branchId == '' || request.auth.token.branchId == 'All' || resource.data.branchId == request.auth.token.branchId)
          );

        // Update:
        // - Owner / Admin: Full update
        // - Drivers: Can ONLY update their own doc and ONLY whitelisted operational keys
        // - Managers: Can update operational staff info in their branch, but CANNOT touch pin or pinHash
        allow update: if isOwner(userId) || isAdmin() ||
          (
            isTenantDriver(userId) && 
            'staffId' in request.auth.token &&
            request.auth.token.staffId == staffId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'currentLat', 'currentLng', 'lastLocationUpdate',
              'lastAttendanceDate', 'attendanceMarkedAt', 'batteryLevel', 'updatedAt'
            ])
          ) ||
          (
            isTenantManager(userId) &&
            (!('branchId' in request.auth.token) || request.auth.token.branchId == '' || request.auth.token.branchId == 'All' || resource.data.branchId == request.auth.token.branchId) &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pin', 'pinHash'])
          );

        allow create, delete: if isOwner(userId) || isAdmin();
      }

      // 3. Customers (Subscribers)
      match /customers/{customerId} {
        // Read: Owner, Admin, Manager, and Drivers (drivers read stop addresses and meal types for their biz/branch)
        allow get, list: if isOwner(userId) || isAdmin() ||
          (
            isTenantManager(userId) && 
            (!('branchId' in request.auth.token) || request.auth.token.branchId == '' || request.auth.token.branchId == 'All' || resource.data.branchId == request.auth.token.branchId)
          ) ||
          (
            isTenantDriver(userId) && 
            (!('branchId' in request.auth.token) || request.auth.token.branchId == '' || resource.data.branchId == request.auth.token.branchId)
          );

        // Write: Owner or Admin. Managers can create/update customers in their assigned branch. Drivers have NO write access to customers.
        allow create, update: if isOwner(userId) || isAdmin() || (
          isTenantManager(userId) &&
          (!('branchId' in request.auth.token) || request.auth.token.branchId == '' || request.auth.token.branchId == 'All' || request.resource.data.branchId == request.auth.token.branchId)
        );

        allow delete: if isOwner(userId) || isAdmin();
      }

      // 4. Meal Plans
      match /plans/{planId} {
        allow read: if isOwner(userId) || isTenantManager(userId) || isTenantDriver(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // 5. Kitchen Branches
      match /branches/{branchId} {
        allow read: if isOwner(userId) || isTenantManager(userId) || isTenantDriver(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // 6. Delivery Logs (Daily Meal Delivery & Box Recollection)
      match /delivery_logs/{logId} {
        allow read: if isOwner(userId) || isTenantManager(userId) || isTenantDriver(userId) || isAdmin();
        // Drivers can create and update delivery logs for their own bizId
        allow create, update: if isOwner(userId) || isTenantManager(userId) || isTenantDriver(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // 7. Per-Driver Manifest (Replaces global shared hot document)
      match /driver_manifest/{staffId} {
        allow read, write: if isOwner(userId) || isTenantManager(userId) || isAdmin() ||
          (isTenantDriver(userId) && 'staffId' in request.auth.token && request.auth.token.staffId == staffId);
      }

      // 8. Per-Driver Real-Time Status & Location (Replaces global shared document)
      match /driver_status/{staffId} {
        allow read, write: if isOwner(userId) || isTenantManager(userId) || isAdmin() ||
          (isTenantDriver(userId) && 'staffId' in request.auth.token && request.auth.token.staffId == staffId);
      }

      // 9. Branch Managers Collection (Owner and Admin ONLY; managers cannot view or manage other managers)
      match /managers/{managerId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // 10. Manager Audit Logs
      match /manager_logs/{logId} {
        allow read: if isOwner(userId) || isTenantManager(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin() || (
          isTenantManager(userId) && 'managerId' in request.auth.token && request.resource.data.managerId == request.auth.token.managerId
        );
        allow update: if isOwner(userId) || isAdmin() || (
          isTenantManager(userId) && 'managerId' in request.auth.token && resource.data.managerId == request.auth.token.managerId
        );
        allow delete: if isOwner(userId) || isAdmin();
      }

      // 11. Reusable Box Types (Asset Configuration)
      match /box_types/{boxId} {
        // Managers can read box types to assign to customers; writes restricted to Owner and Admin
        allow read: if isOwner(userId) || isTenantManager(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // 12. Sensitive Financial & Operational Collections (Owner and Admin ONLY)
      // Managers and drivers have NO access to payments, invoices, expenses, billing, inventory, or notes.
      match /invoices/{invoiceId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /payments/{paymentId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      // Phase 3: Client write access to billing_history is revoked.
      // Only Cloud Functions using Admin SDK (and Super Admins) may write billing_history.
      match /billing_history/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }
      match /expenses/{expenseId} {
        allow read, write: if isOwner(userId) || isTenantManager(userId) || isAdmin();
      }
      match /inventory/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /notes/{noteId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /single_orders/{orderId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // 13. Other private subcollections (Strictly isolated by subcollection and doc)
      match /{otherSubcollection}/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // =========================================================================
    // COLLECTION GROUPS (Super Admin Analytics ONLY)
    // =========================================================================
    match /{path=**}/billing_history/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/payments/{docId} {
      allow read: if isAdmin();
    }
  }
}