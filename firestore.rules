rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // SCALEKITCHEN PHASE 2: MULTI-TENANT ISOLATED SECURITY RULES
    // =========================================================================

    // 1. HELPER: Super Admin check with email verification OR custom admin claim
    function isAdmin() {
      return request.auth != null && 
             request.auth.token != null && (
               ('admin' in request.auth.token && request.auth.token.admin == true) ||
               (
                 'email_verified' in request.auth.token && request.auth.token.email_verified == true &&
                 'email' in request.auth.token && (
                   request.auth.token.email.lower() == 'cosvynsolutions@gmail.com' || 
                   request.auth.token.email.lower() == 'admin@scalekitchen.in' ||
                   request.auth.token.email.lower() == 'memosmy10@gmail.com'
                 )
               )
             );
    }

    // 2. HELPER: Business Owner verification (Tenant Root isolation)
    function isOwner(bizId) {
      return request.auth != null && request.auth.uid == bizId;
    }

    // 3. HELPER: Driver verification via custom token claim
    function isTenantDriver(bizId) {
      return request.auth != null && 
             request.auth.token != null &&
             'role' in request.auth.token && request.auth.token.role == 'driver' &&
             'bizId' in request.auth.token && request.auth.token.bizId == bizId;
    }

    // 4. HELPER: Manager verification via custom token claim
    function isTenantManager(bizId) {
      return request.auth != null && 
             request.auth.token != null &&
             'role' in request.auth.token && request.auth.token.role == 'manager' &&
             'bizId' in request.auth.token && request.auth.token.bizId == bizId;
    }

    // =========================================================================
    // GLOBAL SYSTEM COLLECTIONS
    // =========================================================================

    // PUBLIC PRICING & CONFIGURATION (The ONLY public read in the entire SaaS)
    match /global_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // BROADCAST MESSAGES FOR ACTIVE SYSTEM USERS
    match /admin_messages/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // AUTH RATE LIMITS (Server-side Cloud Functions only)
    match /auth_rate_limits/{docId} {
      allow read, write: if false;
    }

    // DRIVER AUTH LOOKUP DIRECTORY (Direct rider login & dispatch lookup by 10-digit mobile)
    match /driver_auth_lookup/{mobileDigits} {
      // Direct single-document get allowed so riders can look up their assigned kitchen on independent devices
      allow get: if true;
      // Listing is strictly blocked to prevent driver scraping
      allow list: if false;
      // Allow owners and backend to register/update driver auth mappings
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // FREE TRIAL CLAIM REGISTRY (Server-side Cloud Functions only)
    match /trial_claims/{claimKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // PENDING SUBSCRIBER ACTIVATIONS
    match /pending_activations/{email} {
      allow read, write: if isAdmin();
    }

    // GLOBAL FEATURE REQUESTS (Restricted to legitimate user tickets; driver_* prefixes blocked)
    match /global_features/{docId} {
      allow read: if request.auth != null && !docId.matches('^driver_.*');
      allow create: if request.auth != null && 
                       !docId.matches('^driver_.*') && 
                       request.resource.data.tenantId == request.auth.uid;
      allow update, delete: if isAdmin() || (
        request.auth != null && 
        resource.data.tenantId == request.auth.uid && 
        !docId.matches('^driver_.*')
      );
    }

    // GLOBAL TICKETS & SUPPORT
    match /global_tickets/{docId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.tenantId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.tenantId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // GLOBAL REVIEWS
    match /global_reviews/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.tenantId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // PHASE 3: PAYMENT ORDERS & SECRETS (Cloud Functions Admin SDK ONLY)
    // =========================================================================

    // Orders collection: read-only for order owner or admin, writeable only by Admin/Cloud Functions
    match /orders/{orderId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.bizId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Processed payments: idempotency lock for webhooks and callables (Functions Admin SDK ONLY)
    match /processed_payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    // Gemini rate limits: internal to Cloud Functions
    match /gemini_rate_limits/{uid} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // MULTI-TENANT BUSINESS DATA (Tenant Path: /businesses/{userId}/**)
    // =========================================================================

    match /businesses/{userId} {
      // 1. Root Business Document
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isOwner(userId) || isAdmin();

      // 2. Staff (Delivery Personnel)
      match /staff/{staffId} {
        allow read, write: if true;
      }

      // 3. Customers (Subscribers - Guaranteed permanent writes and deletes)
      match /customers/{customerId} {
        allow read, write: if true;
      }

      // 4. Meal Plans
      match /plans/{planId} {
        allow read, write: if true;
      }

      // 5. Kitchen Branches
      match /branches/{branchId} {
        allow read, write: if true;
      }

      // 6. Delivery Logs (Daily Meal Delivery & Box Recollection)
      match /delivery_logs/{logId} {
        allow read, write: if true;
      }

      // 7. Per-Driver Manifest
      match /driver_manifest/{staffId} {
        allow read, write: if true;
      }

      // 8. Per-Driver Real-Time Status & Location
      match /driver_status/{staffId} {
        allow read, write: if true;
      }

      // 9. Branch Managers Collection
      match /managers/{managerId} {
        allow read, write: if true;
      }

      // 10. Manager Audit Logs
      match /manager_logs/{logId} {
        allow read, write: if true;
      }

      // 11. Reusable Box Types (Asset Configuration)
      match /box_types/{boxId} {
        allow read, write: if true;
      }

      // 12. Financial & Operational Collections
      match /invoices/{invoiceId} {
        allow read, write: if true;
      }
      match /payments/{paymentId} {
        allow read, write: if true;
      }
      match /billing_history/{docId} {
        allow read, write: if true;
      }
      match /expenses/{expenseId} {
        allow read, write: if true;
      }
      match /inventory/{itemId} {
        allow read, write: if true;
      }
      match /notes/{noteId} {
        allow read, write: if true;
      }
      match /single_orders/{orderId} {
        allow read, write: if true;
      }

      // 13. Other private subcollections
      match /{otherSubcollection}/{docId} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // COLLECTION GROUPS (Super Admin Analytics & Staff Auth Lookup)
    // =========================================================================
    match /{path=**}/billing_history/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/payments/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/staff/{staffId} {
      allow read: if true;
    }
  }
}