rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // SCALEKITCHEN PHASE 2: HARDENED MULTI-TENANT SECURITY RULES
    // =========================================================================
    // Key principles:
    // 1. Browser NEVER directly modifies subscription, payments, or sensitive tenant data
    // 2. Drivers and Managers authenticate via callable, receive custom token with claims
    // 3. All tenant data scoped by businessId; custom claims enforce per-request access
    // 4. Plaintext data (PINs, passwords) never leave Cloud Functions
    // =========================================================================

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    // 1. Super Admin check: email verified + explicit admin claim OR hardcoded list
    function isAdmin() {
      return request.auth != null && 
             request.auth.token != null && (
               ('admin' in request.auth.token && request.auth.token.admin == true) ||
               (
                 'email_verified' in request.auth.token && 
                 request.auth.token.email_verified == true &&
                 'email' in request.auth.token && (
                   request.auth.token.email.lower() == 'cosvynsolutions@gmail.com' || 
                   request.auth.token.email.lower() == 'admin@scalekitchen.in' ||
                   request.auth.token.email.lower() == 'memosmy10@gmail.com'
                 )
               )
             );
    }

    // 2. Business Owner check: uid == businessId
    function isOwner(bizId) {
      return request.auth != null && request.auth.uid == bizId;
    }

    // 3. Delivery Driver check: custom token claim validates role + bizId
    //    Driver can only act within their assigned business
    function isTenantDriver(bizId) {
      return request.auth != null && 
             request.auth.token != null &&
             'role' in request.auth.token && 
             request.auth.token.role == 'driver' &&
             'bizId' in request.auth.token && 
             request.auth.token.bizId == bizId &&
             isActiveDriver(bizId);
    }

    function isActiveDriver(bizId) {
      return request.auth != null &&
             request.auth.token != null &&
             'staffId' in request.auth.token &&
             exists(/databases/$(database)/documents/businesses/$(bizId)/staff/$(request.auth.token.staffId)) &&
             get(/databases/$(database)/documents/businesses/$(bizId)/staff/$(request.auth.token.staffId)).data.active != false &&
             get(/databases/$(database)/documents/businesses/$(bizId)/staff/$(request.auth.token.staffId)).data.status != 'Inactive';
    }

    // 4. Branch Manager check: custom token claim validates role + bizId
    //    Manager can only act within their assigned business
    function isTenantManager(bizId) {
      return request.auth != null && 
             request.auth.token != null &&
             'role' in request.auth.token && 
             request.auth.token.role == 'manager' &&
             'bizId' in request.auth.token && 
             request.auth.token.bizId == bizId;
    }

    function isOwnManager(managerId) {
      return request.auth != null &&
             request.auth.token != null &&
             'managerId' in request.auth.token &&
             request.auth.token.managerId == managerId;
    }

    function isOwnDriver(staffId) {
      return request.auth != null &&
             request.auth.token != null &&
             'staffId' in request.auth.token &&
             request.auth.token.staffId == staffId;
    }

    function isEmployeeToken() {
      return request.auth != null &&
             request.auth.token != null &&
             'role' in request.auth.token &&
             request.auth.token.role in ['driver', 'manager'];
    }

    function hasNoServerManagedBusinessFields() {
      return !request.resource.data.keys().hasAny([
        'planName', 'planStatus', 'planExpiryDate', 'lastPaymentId',
        'trialClaimed', 'trialStartDate', 'trialDurationDays',
        'trialOriginalStartDate', 'trialExpiryDate',
        'trialOriginalExpiryDate', 'purchasedInvoiceCredits',
        'lastRechargePlan', 'monthlyFreeUsed', 'lastInvoiceResetMonth'
      ]);
    }

    // =========================================================================
    // PUBLIC / GLOBAL SYSTEM COLLECTIONS
    // =========================================================================

    // Pricing & Global Configuration (READ-ONLY for everyone)
    match /global_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System broadcast messages (logged-in users only)
    match /admin_messages/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Rate limits (server-side Cloud Functions only)
    match /auth_rate_limits/{docId} {
      allow read, write: if false;
    }

    // Driver authentication lookup is server-only because it contains PIN hashes.
    match /driver_auth_lookup/{mobileDigits} {
      allow read, write: if false;
    }

    // Free Trial Claim Registry (server-side only)
    match /trial_claims/{claimKey} {
      allow read, write: if false;
    }

    // Pending activation data is visible only to the authenticated account it belongs to.
    match /pending_activations/{email} {
      allow get, delete: if request.auth != null &&
                            'email' in request.auth.token &&
                            request.auth.token.email is string &&
                            request.auth.token.email.lower() == email.lower();
      allow list, create, update: if false;
    }

    // Global Feature Requests (logged-in users only, no driver prefix)
    match /global_features/{docId} {
      allow read: if isAdmin() ||
                     (request.auth != null && !isEmployeeToken());
      allow create: if request.auth != null && !isEmployeeToken() &&
                       request.resource.data.tenantId == request.auth.uid;
      allow update, delete: if isAdmin() || 
                            (request.auth != null && !isEmployeeToken() &&
                             resource.data.tenantId == request.auth.uid);
    }

    // Global Support Tickets
    match /global_tickets/{docId} {
      allow read: if isAdmin() || 
                     (request.auth != null && resource.data.tenantId == request.auth.uid);
      allow create: if request.auth != null && 
                       request.resource.data.tenantId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Global Reviews (logged-in users)
    match /global_reviews/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
                       request.resource.data.tenantId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // PHASE 3: PAYMENT ORDERS & SECRETS (Cloud Functions Admin SDK ONLY)
    // Browser can NEVER read or write these directly
    // =========================================================================

    match /orders/{orderId} {
      allow read, write: if false; // Admin SDK only
    }

    match /processed_payments/{paymentId} {
      allow read, write: if false; // Admin SDK only
    }

    match /gemini_rate_limits/{uid} {
      allow read, write: if false; // Admin SDK only
    }

    // =========================================================================
    // MULTI-TENANT BUSINESS DATA (Core: /businesses/{userId}/*)
    // =========================================================================

    match /businesses/{userId} {
      // Business root profile: owner can read/write, drivers/managers can read only
      allow get: if isOwner(userId) || 
                    isTenantDriver(userId) || 
                    isTenantManager(userId) || 
                    isAdmin();
      allow list: if isAdmin();
      
      // Owner can create their own business
      allow create: if isAdmin() || (isOwner(userId) && hasNoServerManagedBusinessFields());
      
      // Owner delete
      allow delete: if isOwner(userId) || isAdmin();

      // Owners may edit profile fields, but subscription and payment state is server-managed.
      allow update: if isAdmin() || (
        isOwner(userId) && (
          // Auto-expiry may only change status and the update timestamp.
          (
            resource.data.planStatus == 'Active' &&
            request.resource.data.planStatus == 'Expired' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'planStatus', 'updatedAt'
            ])
          ) ||
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'planExpiryDate', 'planStatus', 'planName', 'lastPaymentId',
              'trialClaimed', 'trialStartDate', 'trialDurationDays',
              'trialOriginalStartDate', 'trialExpiryDate',
              'trialOriginalExpiryDate', 'purchasedInvoiceCredits',
              'lastRechargePlan', 'monthlyFreeUsed', 'lastInvoiceResetMonth'
            ])
          )
        )
      );

      // --- Staff Subcollection (Delivery Partners) ---
      match /staff/{staffId} {
        // Driver clients must not read staff documents because legacy records may contain PIN hashes.
        allow read: if isOwner(userId) || 
                       isTenantManager(userId) || 
                       isAdmin();
        
        // Owner and managers can create/update; drivers can only update their own location/status
        allow create, delete: if isOwner(userId) || isTenantManager(userId) || isAdmin();
        
        allow update: if isOwner(userId) || isTenantManager(userId) || isAdmin() ||
          (
            isTenantDriver(userId) &&
            isOwnDriver(staffId) &&
            // Drivers can ONLY update location, status, and attendance (never PIN or name)
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'currentLat', 'currentLng', 'lastLocationUpdate',
              'lastAttendanceDate', 'attendanceMarkedAt', 'punchInTime',
              'isShiftActive', 'batteryLevel', 'updatedAt'
            ]) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
              request.resource.data.status in ['Online', 'Offline'])
          );
      }

      // --- Customers Subcollection (Subscribers) ---
      match /customers/{customerId} {
        allow read: if isOwner(userId) || 
                       isTenantManager(userId) || 
                       isTenantDriver(userId) || 
                       isAdmin();
        
        allow create, delete: if isOwner(userId) || isTenantManager(userId) || isAdmin();
        
        allow update: if isOwner(userId) || isTenantManager(userId) || isAdmin() ||
          (
            isTenantDriver(userId) &&
            // Drivers can only update box collection tracking, NOT customer details
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'boxCollections', 'uncollectedBoxesCount', 'updatedAt'
            ]) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['boxCollections']) ||
              request.resource.data.boxCollections is map) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uncollectedBoxesCount']) ||
              (
                request.resource.data.uncollectedBoxesCount is int &&
                request.resource.data.uncollectedBoxesCount >= 0 &&
                (
                  resource.data.uncollectedBoxesCount is int
                    ? request.resource.data.uncollectedBoxesCount <= resource.data.uncollectedBoxesCount
                    : request.resource.data.uncollectedBoxesCount <= 1
                )
              ))
          );
      }

      // --- Delivery Logs Subcollection ---
      match /delivery_logs/{logId} {
        allow read: if isOwner(userId) || 
                       isTenantManager(userId) || 
                       isTenantDriver(userId) || 
                       isAdmin();
        
        allow create: if isOwner(userId) || isTenantManager(userId) || isAdmin() ||
          (
            isTenantDriver(userId) &&
            'staffId' in request.auth.token &&
            request.resource.data.deliveryBoyId == request.auth.token.staffId &&
            request.resource.data.keys().hasOnly([
              'date', 'customerId', 'customerName', 'branchId',
              'deliveryBoyId', 'deliveryBoyName', 'mealTime', 'status',
              'deliveredAt', 'reusableBoxEnabled', 'boxType', 'isDay2Plus',
              'boxStatus', 'boxNotes', 'boxCollectedAt', 'currentLat',
              'currentLng', 'updatedAt'
            ]) &&
            request.resource.data.date is string &&
            request.resource.data.customerId is string &&
            request.resource.data.mealTime is string &&
            (!('status' in request.resource.data) ||
              request.resource.data.status is string)
          );

        allow update: if isOwner(userId) || isTenantManager(userId) || isAdmin() ||
          (
            isTenantDriver(userId) &&
            'staffId' in request.auth.token &&
            resource.data.deliveryBoyId == request.auth.token.staffId &&
            request.resource.data.deliveryBoyId == request.auth.token.staffId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'date', 'customerId', 'customerName', 'branchId',
              'deliveryBoyId', 'deliveryBoyName', 'mealTime', 'status',
              'deliveredAt', 'reusableBoxEnabled', 'boxType', 'isDay2Plus',
              'boxStatus', 'boxNotes', 'boxCollectedAt', 'currentLat',
              'currentLng', 'updatedAt'
            ]) &&
            (!('status' in request.resource.data) ||
              request.resource.data.status is string)
          );
        
        allow delete: if isOwner(userId) || isAdmin();
      }

      // --- Driver Manifest (per-driver route for the day) ---
      match /driver_manifest/{staffId} {
        allow read: if isOwner(userId) || 
                       isTenantManager(userId) || 
                       (isTenantDriver(userId) && isOwnDriver(staffId)) ||
                       isAdmin();
        
        allow create: if isOwner(userId) || isTenantManager(userId) || isAdmin() ||
          (
            isTenantDriver(userId) &&
            isOwnDriver(staffId) &&
            request.resource.data.keys().hasOnly([
              'status', 'lastAttendanceDate', 'attendanceMarkedAt',
              'punchInTime', 'isShiftActive', 'updatedAt'
            ]) &&
            request.resource.data.keys().hasAll(['status', 'isShiftActive', 'updatedAt']) &&
            request.resource.data.status in ['Online', 'Offline'] &&
            request.resource.data.isShiftActive is bool &&
            (
              (request.resource.data.status == 'Online' && request.resource.data.isShiftActive == true) ||
              (request.resource.data.status == 'Offline' && request.resource.data.isShiftActive == false)
            ) &&
            request.resource.data.updatedAt is string &&
            (!('lastAttendanceDate' in request.resource.data) || request.resource.data.lastAttendanceDate is string) &&
            (!('attendanceMarkedAt' in request.resource.data) || request.resource.data.attendanceMarkedAt is string) &&
            (!('punchInTime' in request.resource.data) || request.resource.data.punchInTime is string)
          );

        allow update: if isOwner(userId) || isTenantManager(userId) || isAdmin() ||
          (
            isTenantDriver(userId) &&
            isOwnDriver(staffId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'lastAttendanceDate', 'attendanceMarkedAt',
              'punchInTime', 'isShiftActive', 'updatedAt'
            ]) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
              request.resource.data.status in ['Online', 'Offline']) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastAttendanceDate']) ||
              request.resource.data.lastAttendanceDate is string) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['attendanceMarkedAt']) ||
              request.resource.data.attendanceMarkedAt is string) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['punchInTime']) ||
              request.resource.data.punchInTime is string) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isShiftActive']) ||
              request.resource.data.isShiftActive is bool) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) ||
              request.resource.data.updatedAt is string) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'isShiftActive']) ||
              (
                'status' in request.resource.data &&
                'isShiftActive' in request.resource.data &&
                (
                  (request.resource.data.status == 'Online' && request.resource.data.isShiftActive == true) ||
                  (request.resource.data.status == 'Offline' && request.resource.data.isShiftActive == false)
                )
              ))
          );

        allow delete: if isOwner(userId) || isTenantManager(userId) || isAdmin();
      }

      // --- Driver Status (real-time: online/offline, GPS, battery) ---
      match /driver_status/{staffId} {
        allow read: if isOwner(userId) || 
                       isTenantManager(userId) || 
                       (isTenantDriver(userId) && isOwnDriver(staffId)) ||
                       isAdmin();
        
        allow create: if isOwner(userId) || isTenantManager(userId) || isAdmin() ||
          (
            isTenantDriver(userId) &&
            isOwnDriver(staffId) &&
            request.resource.data.keys().hasOnly([
              'staffId', 'riderName', 'mobile', 'status', 'lastAttendanceDate',
              'attendanceMarkedAt', 'punchInTime', 'isShiftActive',
              'currentLat', 'currentLng', 'accuracy', 'lastLocationUpdate',
              'initialLat', 'initialLng', 'endTime', 'punchOutTime',
              'durationMinutes', 'finalLat', 'finalLng', 'updatedAt'
            ]) &&
            (!('staffId' in request.resource.data) || request.resource.data.staffId == staffId) &&
            (!('status' in request.resource.data) || request.resource.data.status in ['Online', 'Offline']) &&
            (!('isShiftActive' in request.resource.data) || request.resource.data.isShiftActive is bool)
          );

        allow update: if isOwner(userId) || isTenantManager(userId) || isAdmin() ||
          (
            isTenantDriver(userId) &&
            isOwnDriver(staffId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'staffId', 'riderName', 'mobile', 'status', 'lastAttendanceDate',
              'attendanceMarkedAt', 'punchInTime', 'isShiftActive',
              'currentLat', 'currentLng', 'accuracy', 'lastLocationUpdate',
              'initialLat', 'initialLng', 'endTime', 'punchOutTime',
              'durationMinutes', 'finalLat', 'finalLng', 'updatedAt'
            ]) &&
            (!('staffId' in request.resource.data) || request.resource.data.staffId == staffId) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
              request.resource.data.status in ['Online', 'Offline']) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isShiftActive']) ||
              request.resource.data.isShiftActive is bool)
          );
      }

      // --- Driver Sessions (shift start/end logs) ---
      match /driver_sessions/{sessionId} {
        allow read: if isOwner(userId) || 
                       isTenantManager(userId) || 
                       (isTenantDriver(userId) && isOwnDriver(resource.data.staffId)) ||
                       isAdmin();
        
        allow create: if isOwner(userId) || isTenantManager(userId) || isAdmin() ||
          (
            isTenantDriver(userId) &&
            isOwnDriver(request.resource.data.staffId) &&
            request.resource.data.sessionId == sessionId &&
            request.resource.data.status == 'Active' &&
            request.resource.data.keys().hasOnly([
              'sessionId', 'staffId', 'driverName', 'mobile', 'branchId',
              'date', 'startTime', 'punchInTime', 'endTime', 'punchOutTime',
              'durationMinutes', 'status', 'initialLat', 'initialLng',
              'lastLocationUpdate', 'finalLat', 'finalLng', 'createdAt',
              'updatedAt'
            ])
          );

        allow update: if isOwner(userId) || isTenantManager(userId) || isAdmin() ||
          (
            isTenantDriver(userId) &&
            isOwnDriver(resource.data.staffId) &&
            request.resource.data.staffId == request.auth.token.staffId &&
            request.resource.data.sessionId == sessionId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'endTime', 'punchOutTime', 'durationMinutes', 'status',
              'initialLat', 'initialLng', 'lastLocationUpdate', 'finalLat',
              'finalLng', 'updatedAt'
            ]) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
              request.resource.data.status == 'Completed')
          );
      }

      // --- Branch Managers ---
      match /managers/{managerId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // --- Manager Audit Logs ---
      match /manager_logs/{logId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin() ||
          (
            isTenantManager(userId) &&
            isOwnManager(request.resource.data.managerId) &&
            request.resource.data.keys().hasOnly([
              'id', 'managerId', 'managerName', 'managerEmail',
              'branchId', 'branchName', 'date', 'loginTime',
              'logoutTime', 'status', 'createdAt', 'updatedAt'
            ])
          );
        allow update: if isOwner(userId) || isAdmin() ||
          (
            isTenantManager(userId) &&
            isOwnManager(resource.data.managerId) &&
            request.resource.data.managerId == request.auth.token.managerId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'logoutTime', 'status', 'updatedAt'
            ])
          );
        allow delete: if isOwner(userId) || isAdmin();
      }

      // --- Meal Plans ---
      match /plans/{planId} {
        allow read: if isOwner(userId) || 
                       isTenantManager(userId) || 
                       isTenantDriver(userId) || 
                       isAdmin();
        allow write: if isOwner(userId) || isTenantManager(userId) || isAdmin();
      }

      // --- Kitchen Branches ---
      match /branches/{branchId} {
        allow read: if isOwner(userId) || 
                       isTenantManager(userId) || 
                       isTenantDriver(userId) || 
                       isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // --- Reusable Box Types ---
      match /box_types/{boxId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // --- Financial & Operational (owner/admin only) ---
      match /invoices/{invoiceId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /payments/{paymentId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /billing_history/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // Server only
      }
      match /expenses/{expenseId} {
        allow read, write: if isOwner(userId) || isTenantManager(userId) || isAdmin();
      }
      match /inventory/{itemId} {
        allow read, write: if isOwner(userId) || isTenantManager(userId) || isAdmin();
      }
      match /notes/{noteId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /single_orders/{orderId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Owner login receipts and manager read receipts are app-owned operational data.
      match /login_logs/{logId} {
        allow read, write: if isOwner(userId);
        allow read: if isAdmin();
      }

      match /read_messages/{messageId} {
        allow read, write: if isOwner(userId) || isTenantManager(userId) || isAdmin();
      }

      // Catch-all for other subcollections (deny by default)
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // =========================================================================
    // COLLECTION GROUPS (Analytics & lookup by role)
    // =========================================================================
    
    // Billing history: admins see all, owners see their own
    match /{path=**}/billing_history/{docId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == path[1]);
    }

    // Payment records: admins see all, owners see their own
    match /{path=**}/payments/{docId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == path[1]);
    }

    // Staff lookup by mobile (no direct reads except via driverLogin callable)
    match /{path=**}/staff/{staffId} {
      allow read: if false; // Server only
    }

  }
}