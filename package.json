{
  "name": "scalekitchen-–-saas-for-subscription-meal-businesses",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:all": "vite build",
    "build:landing": "npm run build --workspace=@scalekitchen/landing",
    "build:owner": "npm run build --workspace=@scalekitchen/owner",
    "build:delivery": "npm run build --workspace=@scalekitchen/delivery",
    "build:manager": "npm run build --workspace=@scalekitchen/manager",
    "build:admin": "npm run build --workspace=@scalekitchen/admin",
    "dev:landing": "npm run dev --workspace=@scalekitchen/landing",
    "dev:owner": "npm run dev --workspace=@scalekitchen/owner",
    "dev:delivery": "npm run dev --workspace=@scalekitchen/delivery",
    "dev:manager": "npm run dev --workspace=@scalekitchen/manager",
    "dev:admin": "npm run dev --workspace=@scalekitchen/admin",
    "lint": "tsc",
    "lint:all": "tsc --noEmit",
    "lint:landing": "npm run lint --workspace=@scalekitchen/landing",
    "lint:owner": "npm run lint --workspace=@scalekitchen/owner",
    "lint:delivery": "npm run lint --workspace=@scalekitchen/delivery",
    "lint:manager": "npm run lint --workspace=@scalekitchen/manager",
    "lint:admin": "npm run lint --workspace=@scalekitchen/admin",
    "preview": "vite preview",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:rules": "vitest run test/firestore-rules.test.ts",
    "postinstall": "node scripts/patch-firestore.cjs"
  },
  "dependencies": {
    "@google/genai": "^1.31.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "firebase": "11.3.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.10.1",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  }
}
