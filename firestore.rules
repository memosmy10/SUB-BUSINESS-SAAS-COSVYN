rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. HELPER: Robust check for Super Admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token != null && 
             'email' in request.auth.token && (
               request.auth.token.email.lower() == 'cosvynsolutions@gmail.com' || 
               request.auth.token.email.lower() == 'admin@scalekitchen.in'
             );
    }

    // 2. PUBLIC SETTINGS
    match /global_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. ADMIN MESSAGES (Broadcast System)
    match /admin_messages/{docId} {
      allow read: if request.auth != null;
      // Double layer of security/permission for the admin write
      allow create, update, delete: if isAdmin();
    }

    // 4. BUSINESS DATA (The core SaaS data)
    match /businesses/{userId} {
      allow get: if true; 
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow list: if isAdmin();

      // Subcollections needed for the Driver Web App & Live Route Tracking:
      match /staff/{staffId} {
        allow read: if true;
        // Allow driver to punch in, update GPS live location and attendance
        allow update: if true;
        allow create, delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      }

      match /delivery_logs/{logId} {
        // Allow drivers to view route stops and mark delivered / box recollection status
        allow read, write: if true;
      }

      match /customers/{customerId} {
        // Allow drivers to read customer stop address, delivery meal preference, phone, and box status
        allow read: if true;
        // Allow updating box collection tracking & uncollected count
        allow update: if true;
        allow create, delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      }

      match /plans/{planId} {
        // Allow drivers to read meal plan names/labels
        allow read: if true;
        allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      }

      // All other subcollections (payments, expenses, invoices, settings, etc.) remain strictly private to the business owner
      match /{allSubcollections=**} {
        allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      }
    }

    // 5. PENDING ACTIVATIONS
    match /pending_activations/{email} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // 6. COLLECTION GROUPS (For Admin Panel Analytics)
    match /{path=**}/billing_history/{docId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == path[1]);
    }
    match /{path=**}/payments/{docId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == path[1]);
    }

    // 7. GLOBAL INTERACTIONS
    match /global_features/{docId} { allow read, write: if request.auth != null; }
    match /global_tickets/{docId} { allow read, write: if request.auth != null; }
    match /global_reviews/{docId} { allow read, write: if request.auth != null; }
  }
}