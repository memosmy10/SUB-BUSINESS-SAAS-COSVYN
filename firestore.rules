rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- HELPERS ----------
    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('email', '').lower() in [
          'cosvynsolutions@gmail.com',
          'admin@scalekitchen.in',
          'memosmy10@gmail.com'   // remove if this is not your admin
        ]
      );
    }

    function isOwner(bizId) { return signedIn() && request.auth.uid == bizId; }

    function isDriver(bizId) {
      return signedIn() &&
        request.auth.token.get('role', '') == 'driver' &&
        request.auth.token.get('bizId', '') == bizId;
    }

    function isManager(bizId) {
      return signedIn() &&
        request.auth.token.get('role', '') == 'manager' &&
        request.auth.token.get('bizId', '') == bizId;
    }

    function isOwnDriverDoc(bizId, staffId) {
      return isDriver(bizId) && request.auth.token.get('staffId', '') == staffId;
    }

    // ---------- PUBLIC / GLOBAL ----------
    match /global_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_messages/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Server-only collections (Cloud Functions use the Admin SDK and bypass rules)
    match /auth_rate_limits/{docId}     { allow read, write: if false; }
    match /driver_auth_lookup/{docId}   { allow read, write: if false; }
    match /processed_payments/{docId}   { allow read, write: if false; }
    match /gemini_rate_limits/{docId}   { allow read, write: if false; }
    match /trial_claims/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.bizId == request.auth.uid);
      allow write: if false;
    }

    match /pending_activations/{email} {
      allow get: if isAdmin() ||
        (signedIn() && request.auth.token.get('email', '').lower() == email.lower());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // driver_* docs (legacy PIN/manifest leaks) are blocked for everyone except admin reads
    match /global_features/{docId} {
      allow read: if isAdmin() || (signedIn() && !docId.matches('driver_.*'));
      allow create: if signedIn() && !docId.matches('driver_.*');
      allow update, delete: if isAdmin() || (signedIn() && !docId.matches('driver_.*'));
    }
    match /global_tickets/{docId}  { allow read, write: if signedIn(); }
    match /global_reviews/{docId}  { allow read, write: if signedIn(); }

    // ---------- TENANT DATA ----------
    match /businesses/{bizId} {

      allow get: if isOwner(bizId) || isManager(bizId) || isDriver(bizId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isOwner(bizId) || isAdmin();

      // Staff / delivery partners
      match /staff/{staffId} {
        allow read: if isOwner(bizId) || isManager(bizId) || isAdmin() || isOwnDriverDoc(bizId, staffId);
        allow create, delete: if isOwner(bizId) || isManager(bizId) || isAdmin();
        allow update: if isOwner(bizId) || isManager(bizId) || isAdmin() ||
          (
            isOwnDriverDoc(bizId, staffId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'currentLat', 'currentLng', 'lastLocationUpdate',
              'lastAttendanceDate', 'attendanceMarkedAt', 'punchInTime',
              'isShiftActive', 'batteryLevel', 'updatedAt'
            ])
          );
      }

      // Owner-only plaintext PIN storage (so owner can see/share PINs)
      match /staff_credentials/{staffId} {
        allow read, write: if isOwner(bizId) || isAdmin();
      }

      // Per-rider live data (rider can only touch their own)
      match /driver_status/{staffId} {
        allow read, write: if isOwner(bizId) || isManager(bizId) || isAdmin() || isOwnDriverDoc(bizId, staffId);
      }
      match /driver_manifest/{staffId} {
        allow read, write: if isOwner(bizId) || isManager(bizId) || isAdmin() || isOwnDriverDoc(bizId, staffId);
      }
      match /driver_sessions/{sessionId} {
        allow read, write: if isOwner(bizId) || isManager(bizId) || isAdmin() ||
          (isDriver(bizId) && sessionId.matches('.*_' + request.auth.token.get('staffId', '#none#')));
      }

      // Customers: riders may read, and only update box-tracking fields
      match /customers/{customerId} {
        allow read: if isOwner(bizId) || isManager(bizId) || isDriver(bizId) || isAdmin();
        allow create, delete: if isOwner(bizId) || isManager(bizId) || isAdmin();
        allow update: if isOwner(bizId) || isManager(bizId) || isAdmin() ||
          (
            isDriver(bizId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'boxCollections', 'uncollectedBoxesCount', 'updatedAt', 'routeOrder'
            ])
          );
      }

      match /delivery_logs/{logId} {
        allow read: if isOwner(bizId) || isManager(bizId) || isDriver(bizId) || isAdmin();
        allow create, update: if isOwner(bizId) || isManager(bizId) || isDriver(bizId) || isAdmin();
        allow delete: if isOwner(bizId) || isAdmin();
      }

      match /plans/{planId} {
        allow read: if isOwner(bizId) || isManager(bizId) || isDriver(bizId) || isAdmin();
        allow write: if isOwner(bizId) || isManager(bizId) || isAdmin();
      }
      match /branches/{branchId} {
        allow read: if isOwner(bizId) || isManager(bizId) || isDriver(bizId) || isAdmin();
        allow write: if isOwner(bizId) || isAdmin();
      }
      match /box_types/{boxId} {
        allow read: if isOwner(bizId) || isManager(bizId) || isDriver(bizId) || isAdmin();
        allow write: if isOwner(bizId) || isManager(bizId) || isAdmin();
      }

      // Manager credentials: owner/admin only
      match /managers/{managerId} {
        allow read, write: if isOwner(bizId) || isAdmin();
      }
      match /manager_logs/{logId} {
        allow read, create, update: if isOwner(bizId) || isManager(bizId) || isAdmin();
        allow delete: if isOwner(bizId) || isAdmin();
      }

      // Operational data: owner + manager, never drivers
      match /expenses/{id}      { allow read, write: if isOwner(bizId) || isManager(bizId) || isAdmin(); }
      match /inventory/{id}     { allow read, write: if isOwner(bizId) || isManager(bizId) || isAdmin(); }
      match /notes/{id}         { allow read, write: if isOwner(bizId) || isManager(bizId) || isAdmin(); }
      match /single_orders/{id} { allow read, write: if isOwner(bizId) || isManager(bizId) || isAdmin(); }
      match /payments/{id}      { allow read, write: if isOwner(bizId) || isManager(bizId) || isAdmin(); }
      match /invoices/{id}      { allow read, write: if isOwner(bizId) || isManager(bizId) || isAdmin(); }
      match /read_messages/{id} { allow read, write: if isOwner(bizId) || isManager(bizId) || isAdmin(); }

      // Billing: owner/admin only
      match /billing_history/{id} { allow read, write: if isOwner(bizId) || isAdmin(); }

      // Everything else (login_logs, etc.): owner/admin only
      match /{other=**} {
        allow read, write: if isOwner(bizId) || isAdmin();
      }
    }

    // ---------- COLLECTION GROUPS (Admin analytics only) ----------
    match /{path=**}/billing_history/{docId} { allow read: if isAdmin(); }
    match /{path=**}/payments/{docId}        { allow read: if isAdmin(); }
  }
}